NODE_ENV=development
PORT=3000

ACCESS_KEY=replace-with-at-least-32-random-characters
REFRESH_KEY=replace-with-another-32-random-characters
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_base

# Reserved for future adapters. Redis and Kafka are not required by the current runtime.
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9092
OBSERVABILITY_SERVICE_NAME=nest-baserepo
